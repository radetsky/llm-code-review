#!/bin/bash
# Pre-push hook for LLM code review.
# Advisory only: findings are printed, the push is never blocked.

if [ ! -f "review.py" ]; then
    echo "⚠️  review.py not found. Skipping code review."
    exit 0
fi

REVIEW_RESULT_FILE="/tmp/llm-review-$(date +%s).json"

echo "🚀 Running LLM code review before push (advisory)..."
python review.py --mode all --format json > "$REVIEW_RESULT_FILE"
exit_code=$?

if [ $exit_code -eq 0 ] && [ -s "$REVIEW_RESULT_FILE" ]; then
    python - "$REVIEW_RESULT_FILE" <<'PY'
import json
import sys

try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except (OSError, ValueError):
    print("⚠️  Could not read the review report.")
    sys.exit(0)

critical = data.get("critical_issues", [])
warnings = data.get("warnings", [])
suggestions = data.get("suggestions", [])
print(
    f"📋 Critical: {len(critical)}, warnings: {len(warnings)}, "
    f"suggestions: {len(suggestions)}"
)
for label, items in (("CRITICAL", critical), ("WARNING", warnings)):
    for item in items:
        print(f"   {label}: {item}")
PY
    echo "📄 Full report: $REVIEW_RESULT_FILE"
elif [ $exit_code -eq 4 ]; then
    echo "⚠️  Code review is not configured; push continues."
    echo "   Run 'python review.py --test-connection' to diagnose."
else
    echo "⚠️  Code review did not complete (exit code $exit_code); push continues."
fi

exit 0
