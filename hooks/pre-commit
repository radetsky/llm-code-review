#!/bin/bash
# Pre-commit hook for LLM code review.
# Advisory only: findings are printed, the commit is never blocked.

if [ ! -f "review.py" ]; then
    echo "⚠️  review.py not found. Skipping code review."
    exit 0
fi

echo "🔍 Running LLM code review (advisory)..."
python review.py --mode staged --format text
exit_code=$?

case $exit_code in
    0)
        echo "✅ Code review finished"
        ;;
    4)
        echo ""
        echo "⚠️  Code review is not configured; commit continues."
        echo "   Run 'python review.py --test-connection' to diagnose."
        ;;
    *)
        echo ""
        echo "⚠️  Code review did not complete (exit code $exit_code); commit continues."
        ;;
esac

exit 0
